{
    "name": "@salesforce/commerce-components",
    "version": "1.0.0",
    "private": true,
    "description": "Open Source Commerce Messaging Components",
    "license": "Apache-2.0",
    "author": "salesforce.com",
    "scripts": {
        "lint": "eslint --config .eslintrc.cjs force-app/main/default/lwc/**/*.js",
        "lint:fix": "eslint --config .eslintrc.cjs --fix force-app/main/default/lwc/**/*.js",
        "format": "prettier --write \"force-app/main/default/lwc/**/*.{css,html,js,json,md,xml,yaml,yml}\"",
        "format:verify": "prettier --check \"force-app/main/default/lwc/**/*.{css,html,js,json,md,xml,yaml,yml}\"",
        "postinstall": "husky install",
        "precommit": "lint-staged",
        "ready": "npm run lint && npm run format:verify && npm run test",
        "release": "standard-version -s --releaseCommitMessageFormat \"chore(release): {{currentTag}}\"",
        "test": "sfdx-lwc-jest --coverage --skipApiVersionCheck",
        "test:unit": "sfdx-lwc-jest --skipApiVersionCheck",
        "test:unit:watch": "sfdx-lwc-jest --watch --skipApiVersionCheck",
        "test:unit:debug": "sfdx-lwc-jest --debug --skipApiVersionCheck",
        "test:unit:coverage": "sfdx-lwc-jest --coverage --skipApiVersionCheck",
        "test:unit:coverage:ci": "sfdx-lwc-jest --coverage --skipApiVersionCheck -- --coverageReporters=text --coverageReporters=lcov",
        "test:unit:coverage:html": "sfdx-lwc-jest --coverage --skipApiVersionCheck && open coverage/lcov-report/index.html",
        "test:unit:coverage:watch": "sfdx-lwc-jest --coverage --watch --skipApiVersionCheck",
        "test:unit:coverage:debug": "sfdx-lwc-jest --coverage --debug --skipApiVersionCheck",
        "coverage:check": "npm run test:unit:coverage:ci && echo 'Coverage check completed'",
        "coverage:fix": "npm run test:unit:coverage:ci && echo 'Run specific component tests to improve coverage'",
        "validate": "npm run lint && npm run format:verify && npm run test:unit:coverage",
        "validate:strict": "npm run lint && npm run format:verify && npm run test:unit:coverage:ci",
        "prepare": "husky install",
        "pre-push": "npm run validate:strict"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/forcedotcom/commerce-on-lightning-components.git"
    },
    "devDependencies": {
        "@commitlint/cli": "17.6.6",
        "@commitlint/config-conventional": "17.6.6",
        "@lwc/eslint-plugin-lwc": "1.6.3",
        "@prettier/plugin-xml": "2.2.0",
        "@sa11y/jest": "5.2.0",
        "@salesforce/eslint-config-lwc": "3.4.0",
        "@salesforce/eslint-plugin-lightning": "1.0.0",
        "@salesforce/sfdx-lwc-jest": "7.0.1",
        "baseline-browser-mapping": "^2.10.20",
        "eslint": "8.44.0",
        "eslint-plugin-import": "2.27.5",
        "eslint-plugin-jest": "27.2.2",
        "eslint-plugin-jsdoc": "46.4.3",
        "eslint-plugin-notice": "0.9.10",
        "eslint-plugin-prettier": "4.2.1",
        "husky": "8.0.3",
        "lint-staged": "13.2.3",
        "prettier": "2.8.8",
        "standard-version": "9.5.0"
    },
    "engines": {
        "node": ">=18",
        "npm": ">=8"
    },
    "volta": {
        "node": "18.17.1"
    },
    "lint-staged": {
        "**/*.{css,html,js,json,md,xml,yaml,yml}": [
            "prettier --write"
        ],
        "**/lwc/**/*.js": [
            "eslint --config .eslintrc.cjs --fix",
            "npm run test:unit:coverage"
        ]
    }
}
